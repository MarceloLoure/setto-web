# @pigment-css/nextjs-plugin@0.0.31 (experimental, 0.x) ainda não declara
# suporte oficial ao Next 16 em peerDependencies, embora funcione na prática.
# Sem isto, `npm install` falha com ERESOLVE. Mesma situação já existia no
# projeto original — só não aparecia porque nunca tinha sido instalado do zero.
legacy-peer-deps=true
